# PostgreSQL-Verbindung (bei docker compose automatisch gesetzt)
DATABASE_URL=postgres://spenden:spenden@localhost:5432/spenden
# Gemeinsames Team-Passwort für die Anmeldung
APP_PASSWORD=bitte-aendern
# Mindestens 32 zufällige Zeichen (signiert die Anmelde-Cookies), z. B. mit: openssl rand -hex 32
APP_SECRET=
# Öffentliche Adresse, z. B. https://spenden.eure-domain.de (bei http:// werden Cookies ohne „Secure“ gesetzt)
APP_URL=http://localhost:3100
# Für die KI-Preisrecherche (Claude): Schlüssel von https://platform.claude.com – leer lassen = KI aus
ANTHROPIC_API_KEY=
# Vorgeschlagener Spendenpreis als Anteil vom günstigsten Handelspreis (0.25 = 25 %)
PREISVORSCHLAG_ANTEIL=0.25
