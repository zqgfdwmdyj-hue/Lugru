[{"t":0.0,"text":"🎵 … 🎵","pause":true},{"t":7.7,"text":"Die Post ist da, es hat geschellt,"},{"t":7.71,"text":"Ein Gruß aus einer bunten Welt!"},{"t":9.61,"text":"Ein violetter kleiner Freund"},{"t":11.53,"text":"Hat sich die tollsten Ding' gereimt."},{"t":13.44,"text":"Mit Regenbogen, Pilz am Kopf,"},{"t":15.35,"text":"Greift Grulu tief in seinen Topf:"},{"t":17.26,"text":"Ein Päckchen voller Zauberei,"},{"t":19.18,"text":"Komm mach es auf, sei schnell dabei!"},{"t":21.09,"text":"Grulu, Grulu, Grulu-Box!"},{"t":23.0,"text":"Bunt und fröhlich, voll der Schock!"},{"t":24.93,"text":"Naschen, spielen, staunen, lachen,"},{"t":26.85,"text":"Tausend tolle kleine Sachen!"},{"t":28.77,"text":"Grulu, Grulu, mach sie auf,"},{"t":30.7,"text":"Heut nimmt der Spaß so richtig Lauf!"},{"t":32.62,"text":"Grulu, Grulu, schau doch her!"},{"t":34.55,"text":"Ohne dich wär alles leer!"},{"t":36.48,"text":"YO! HIER IST GRULU, CHECK MAL DAS LEVEL,"},{"t":38.4,"text":"ICH BIN DER TYP, DER KEINE LANGEWEILE KENNT!"},{"t":40.11,"text":"AUS DER BOX DIREKT IN DEIN ZIMMER,"},{"t":41.82,"text":"MIT MIR WIRD JEDER TAG EIN GLANZ-SCHIMMER."},{"t":43.53,"text":"SNACKS, TOYS, ACTION – ALLES AM START,"},{"t":45.24,"text":"MEIN FLOW IST SMOOTH, DEIN ERLEBNIS IST SMART."},{"t":46.96,"text":"PACK ES AUS, ZIEH DAS BAND, LOS JETZT,"},{"t":48.67,"text":"GRULU-BOX-POWER, DIE DEIN HERZ KOMPLETT ERSETZT!"},{"t":50.38,"text":"EINS, ZWEI, DREI – LET'S GO!"},{"t":52.09,"text":"Grulu, Grulu, Grulu-Box!"},{"t":53.8,"text":"Bunt und fröhlich, voll der Schock!"},{"t":55.71,"text":"Naschen, spielen, staunen, lachen,"},{"t":57.62,"text":"Tausend tolle kleine Sachen!"},{"t":59.54,"text":"Grulu, Grulu, mach sie auf,"},{"t":61.45,"text":"Heut nimmt der Spaß so richtig Lauf!"},{"t":63.36,"text":"Grulu, Grulu, schau doch her!"},{"t":65.28,"text":"Ohne dich wär alles leer!"},{"t":67.19,"text":"Das Band geht ab, das Papier fliegt weg,"},{"t":69.1,"text":"Wir suchen das Abenteuer-Versteck!"},{"t":71.03,"text":"Drei, zwei, eins – der Deckel fliegt,"},{"t":72.95,"text":"Schau mal, wer hier die Augen reibt!"},{"t":74.88,"text":"Grulu, Grulu, Grulu-Box!"},{"t":76.8,"text":"🎵 … 🎵","pause":true},{"t":92.2,"text":"Bunt und fröhlich, voll der Schock!"},{"t":94.11,"text":"Naschen, spielen, staunen, lachen,"},{"t":96.03,"text":"Tausend tolle kleine Sachen!"},{"t":97.94,"text":"Grulu, Grulu, mach sie auf,"},{"t":99.85,"text":"Heut nimmt der Spaß so richtig Lauf!"},{"t":101.76,"text":"Grulu, Grulu, schau doch her!"},{"t":103.67,"text":"Ohne dich wär alles leer!"},{"t":105.59,"text":"(Träume fliegen durch den Raum)"},{"t":107.5,"text":"(Schöner als ein bunter Traum!)"},{"t":109.42,"text":"Mit Grulu ist die Welt so weit,"},{"t":111.35,"text":"Bereit für die schönste Zeit!"},{"t":113.28,"text":"Grulu, Grulu, Grulu-Box!"},{"t":115.2,"text":"Bunt und fröhlich, voll der Schock!"},{"t":117.12,"text":"Naschen, spielen, staunen, lachen,"},{"t":119.04,"text":"Tausend tolle kleine Sachen!"},{"t":120.96,"text":"Grulu, Grulu, mach sie auf,"},{"t":122.88,"text":"Heut nimmt der Spaß so richtig Lauf!"},{"t":124.79,"text":"Grulu, Grulu, schau doch her!"},{"t":126.71,"text":"Ohne dich wär alles leer!"},{"t":128.63,"text":"Ja, die Grulu-Box ist da,"},{"t":130.55,"text":"Schreit mit mir ein lautes Hurra!"},{"t":132.47,"text":"Jeden Monat neu erlebt,"},{"t":134.39,"text":"Weil die ganze Bude bebt!"},{"t":136.31,"text":"Grulu, Grulu, wir sind frei,"},{"t":138.22,"text":"Alle Kinder sind dabei!"},{"t":140.14,"text":"Pack sie aus und schau hinein,"},{"t":142.06,"text":"So wird jeder Tag fein!"},{"t":143.98,"text":"Grulu bringt die Freude her..."},{"t":145.9,"text":"Und morgen packen wir die nächste aus!"}]