<!-- WinSW-Konfiguration: lugru-druckagent als Windows-Dienst (Start vor der Anmeldung, Neustart bei Absturz). -->
<service>
  <id>lugru-druckagent</id>
  <name>lugru-druckagent</name>
  <description>Druckagent für das Seller-System (Brother QL-800/QL-1100)</description>
  <executable>%ProgramFiles%\nodejs\node.exe</executable>
  <arguments>"%BASE%\lugru-druckagent.mjs"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>false</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
