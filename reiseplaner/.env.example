# Adresse/Port, auf dem der Planer erreichbar ist (z. B. Tailscale-IP des Servers)
BIND_IP=127.0.0.1
REISE_PORT=3030
# Öffentliche Adresse – für Einladungs- und Freigabe-Links, z. B. https://reise.lugru.de
OEFFENTLICHE_URL=
# Nur für docker-compose.https.yml: Domain, die auf den Server zeigt
REISE_DOMAIN=
# KI (Claude): Schlüssel von console.anthropic.com – für Plan-Import, Assistent und Beitragstexte
ANTHROPIC_API_KEY=
# Optional anderes Modell (Standard: claude-opus-5-5)
KI_MODELL=
# Optional: GetYourGuide-Partner-Zugang (partner.getyourguide.com) – zeigt Angebote direkt in der App
GYG_API_KEY=
GYG_PARTNER_ID=
