# PostgreSQL-Verbindung
DATABASE_URL=postgres://seller:seller@localhost:5432/seller
# Mindestens 32 Zeichen, zufällig. Wird für Sitzungs-Cookies und die Verschlüsselung von Zugangsdaten genutzt.
APP_SECRET=bitte-durch-einen-langen-zufaelligen-wert-ersetzen
# Öffentliche Adresse der App, z. B. https://seller.deine-domain.de (für OAuth-Weiterleitungen)
APP_URL=http://localhost:3000
